# -----------------------------------------------------------------------------
# READY-TO-USE PRESET:  local model (Ollama)  +  local file storage
# -----------------------------------------------------------------------------
# The fully self-contained, no-API-key, nothing-leaves-your-machine setup.
#
# Usage:
#   1. Install Ollama            -> https://ollama.com
#   2. Pull a model              -> ollama pull llama3.1
#      (Ollama's server runs automatically on port 11434.)
#   3. cp .env.local.example .env.local   (Next.js loads .env.local, overriding .env)
#   4. npm run dev
#
# For every available option (Gemini, hosted APIs, Supabase, search), see
# .env.example and WALKTHROUGH.md.

# --- Model: local via Ollama (OpenAI-compatible) ---
LLM_BACKEND=openai
OPENAI_BASE_URL=http://localhost:11434/v1
OPENAI_API_KEY=ollama
OPENAI_MODEL=llama3.1

# --- Storage: local JSON/Markdown files under ./data ---
STORAGE_BACKEND=local

# --- Optional: web / news / scholar search (serper.dev) ---
# SERPER_API_KEY=your_serper_api_key
