# =============================================================================
# LLM BACKEND  —  which model provider the chat uses
# =============================================================================
# gemini (default) = Google Gemini via @google/genai
# openai           = any OpenAI-compatible endpoint, incl. LOCAL models
#                    (Ollama, LM Studio, llama.cpp server, vLLM, Jan, LocalAI)
#                    or hosted APIs (OpenAI, Groq, Together, ...)
# anthropic        = Anthropic Claude via native Messages API
LLM_BACKEND=gemini

# --- Gemini backend (LLM_BACKEND=gemini) -------------------------------------
# Vertex AI express-mode (unified @google/genai SDK, API-key auth — no service account)
USE_VERTEX_AI=true
GOOGLE_VERTEX_API_KEY=your_vertex_ai_express_mode_api_key
GOOGLE_CLOUD_PROJECT=your_gcp_project_id
GOOGLE_CLOUD_LOCATION=global
# Fallback key used when GOOGLE_VERTEX_API_KEY is empty (plain Gemini Developer API key)
GEMINI_API_KEY=

# --- OpenAI-compatible / local backend (LLM_BACKEND=openai) ------------------
# Optional preset that auto-fills OPENAI_BASE_URL for a known provider.
# One of: openai | groq | openrouter | together | deepseek | mistral | xai | perplexity | ollama | lmstudio
OPENAI_PROVIDER=
# Base URL of the OpenAI-compatible server. Common local defaults:
#   Ollama      http://localhost:11434/v1
#   LM Studio   http://localhost:1234/v1
#   llama.cpp   http://localhost:8080/v1
#   OpenAI      https://api.openai.com/v1
OPENAI_BASE_URL=http://localhost:11434/v1
# Any non-empty value works for local runners; use your real key for hosted APIs.
OPENAI_API_KEY=ollama
# Default model, and an optional manual list for the dropdown if the server's
# /v1/models endpoint isn't available.
OPENAI_MODEL=llama3.1
OPENAI_MODELS=llama3.1,qwen2.5,mistral

# --- Anthropic backend (LLM_BACKEND=anthropic) -------------------------------
ANTHROPIC_API_KEY=your_anthropic_api_key
ANTHROPIC_MODEL=claude-3-5-sonnet-latest   # set a current model id (see Anthropic docs)
ANTHROPIC_MODELS=                          # optional comma-separated dropdown list
ANTHROPIC_MAX_TOKENS=4096

# =============================================================================
# STORAGE BACKEND  —  where conversations are stored
# =============================================================================
# local (default) = flat JSON/Markdown files under ./data  (zero setup)
# supabase        = Supabase Postgres (shared/cloud)
STORAGE_BACKEND=local

# --- Supabase backend (STORAGE_BACKEND=supabase) -----------------------------
# Requires:  npm install @supabase/supabase-js
# and running supabase_schema.sql in your project's SQL editor first.
# Get these from your Supabase Dashboard > Settings > API.
SUPABASE_URL=your_supabase_project_url
SUPABASE_SERVICE_KEY=your_supabase_service_role_secret_key

# =============================================================================
# OPTIONAL: Web / news / scholar search (serper.dev)
# =============================================================================
SERPER_API_KEY=your_serper_api_key
